{
  "name": "Agentic Coding Team",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "chat.agent.enabled": true,
        "github.copilot.chat.agent.thinkingTool": true,
        "chat.promptFiles": true,
        "chat.promptFilesRecommendations": true
      }
    }
  },
  "postCreateCommand": "echo 'Agentic coding environment ready. Open Copilot Chat and use @backend-lead, @frontend-lead, or @infra-lead to start.'",
  "remoteUser": "codespace"
}
